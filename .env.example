# Change this before sharing a real deployment.
SECRET_KEY=replace-with-a-long-random-secret

# Change these if another app already uses the default ports.
FRONTEND_PORT=15173
BACKEND_PORT=18000

# Restrict which browser origins may call the API (comma-separated).
# Leave unset to allow any origin (default: "*"). Auth uses Bearer tokens, not
# cookies, so a wildcard here is generally safe, but you can pin it down, e.g.:
# ALLOWED_ORIGINS=http://localhost:15173,http://192.168.1.10:15173
